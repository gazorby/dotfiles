# ── Comments ──
comment_bg = "{{ .bg }}"
comment_draft_bg = "{{ .yellow_bg }}"

# ── Modals ──
modal_border = "{{ .yellow }}"

# ── Pipelines ──
pipeline_success = "{{ .green }}"
