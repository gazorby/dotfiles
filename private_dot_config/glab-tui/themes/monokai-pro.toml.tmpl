pipeline_running = "{{ .cyan }}"
pipeline_pending = "{{ .yellow }}"
pipeline_canceled = "{{ .muted }}"
pipeline_skipped = "{{ .comment }}"

# ── Badges ──
badge_group_bg = "{{ .orange }}"

# ── Label palette ──
label_palette_0 = "{{ .purple }}"
label_palette_1 = "{{ .cyan }}"
label_palette_2 = "{{ .green }}"
label_palette_3 = "{{ .yellow }}"
label_palette_4 = "{{ .red }}"
label_palette_5 = "{{ .orange }}"
label_palette_6 = "{{ .purple_soft }}"
label_palette_7 = "{{ .cyan_soft }}"
label_palette_8 = "{{ .green_soft }}"
label_palette_9 = "{{ .red_soft }}"
{{- end }}
