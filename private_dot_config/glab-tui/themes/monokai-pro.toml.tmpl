{{- with .theme.dark -}}
# Generated from .chezmoidata/theme.toml; glab-tui has no light/dark switching
bg = "{{ .bg }}"
border = "{{ .border }}"
border_focused = "{{ .yellow }}"
header_fg = "{{ .green }}"
highlight_bg = "{{ .selection }}"
inactive_bg = "{{ .editor_bg }}"
text_normal = "{{ .fg }}"
text_muted = "{{ .muted }}"
checked_bg = "{{ .border }}"
green = "{{ .green }}"
green_bg = "{{ .green_bg }}"
red = "{{ .red }}"
red_bg = "{{ .red_bg }}"
blue = "{{ .cyan }}"
blue_bg = "{{ .cyan_bg }}"
yellow = "{{ .yellow }}"
yellow_bg = "{{ .yellow_bg }}"
purple = "{{ .purple }}"
purple_bg = "{{ .purple_bg }}"

# ── Diff ──
diff_addition_fg = "{{ .green }}"
diff_addition_bg = "{{ .green_bg }}"
diff_deletion_fg = "{{ .red }}"
diff_deletion_bg = "{{ .red_bg }}"
diff_gutter_bg = "{{ .bg }}"
