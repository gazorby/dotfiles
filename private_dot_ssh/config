# Machine-local hosts; must precede Host * to take precedence
Include ~/.ssh/config.d/*

Host *
    ControlMaster auto
    ControlPath ~/.ssh/sockets/socket-%C
    ControlPersist 10m
    # Prefer AES-GCM (hardware accelerated), keep remaining defaults
    Ciphers ^aes128-gcm@openssh.com,aes256-gcm@openssh.com
    ServerAliveInterval 60
    ServerAliveCountMax 3
    ConnectTimeout 10
    StrictHostKeyChecking accept-new
    HashKnownHosts no
    LogLevel ERROR
    ExitOnForwardFailure yes
    AddKeysToAgent yes
    IgnoreUnknown UseKeychain
    UseKeychain yes
